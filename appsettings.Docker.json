{
  "UseInMemoryDatabase": false,
  "Database": {
    "Path": "/app/data/vanpatten-airrouter.db",
    "RecreateOnStartup": false
  },
  "Router": {
    "Providers": [
      {
        "Name": "KiloCode",
        "Type": "kilocode",
        "BaseUrl": "https://api.kilo-code.com",
        "ApiKey": "${KILOCODE_API_KEY}",
        "Priority": 100,
        "IsActive": true,
        "RateLimit": {
          "RequestsPerDay": 0,
          "TokensPerDay": 0,
          "RequestsPerHour": 200,
          "TokensPerHour": 0,
          "RequestsPerMinute": 0,
          "TokensPerMinute": 0
        }
      },
      {
        "Name": "Agnes AI",
        "BaseUrl": "https://agnes-ai.com/v1",
        "ApiKey": "${AGNES_AI_API_KEY}",
        "Type": "openai",
        "Headers": {},
        "IsActive": true,
        "Priority": 95,
        "RateLimit": {
          "RequestsPerDay": 0,
          "TokensPerDay": 0,
          "RequestsPerHour": 0,
          "TokensPerHour": 0,
          "RequestsPerMinute": 60,
          "TokensPerMinute": 0
        },
        "SupportsImages": true,
        "ImageTasksOnly": true
      }
    ],
    "Retry": {
      "MaxRetries": 3,
      "BaseDelayMs": 1000,
      "MaxDelayMs": 30000,
      "ExponentialBase": 2
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/vanpatten-airrouter-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ]
  }
}
